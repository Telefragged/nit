{
  "name": "nit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "ensure-wasm": "test -e src/wasm/nit_wasm.js || gen-wasm",
    "dev": "vite",
    "prebuild": "npm run ensure-wasm",
    "build": "npm run check && vite build",
    "precheck": "npm run ensure-wasm",
    "check": "tsc -b tsconfig.json tsconfig.node.json",
    "prelint": "npm run ensure-wasm",
    "lint": "eslint . && stylelint \"src/**/*.css\" && knip",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:unused": "knip",
    "test": "vitest run",
    "screenshots": "node screenshots/capture.mjs"
  },
  "dependencies": {
    "@pierre/trees": "^1.0.0-beta.6",
    "@tanstack/react-query": "^5.103.1",
    "highlight.js": "^11.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@html-eslint/parser": "^0.66.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "knip": "^6.36.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
